# merit-badge-app (~/Documents/merit-badge-app)
# Project-specific only. OS / editor / language / secrets / agent-worktree
# patterns all live in ~/.gitignore_global.

# Keep the example env file even though global ignores .env*
!.env.example

# Lockfiles - intentionally untracked (homelab project, single dev)
package-lock.json
yarn.lock

# Build outputs
dist/
build/
*.min.js
*.min.css

# Uploaded files (user content) - keep the marker so the dir exists
public/uploads/*
!public/uploads/.gitkeep

# Apache config (keep example)
.htaccess
!.htaccess.example
